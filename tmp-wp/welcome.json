"/**\n * Rareearth Curator Welcome Email (WPCode PHP snippet, run everywhere)\n * Called by the Seller Notebook \"register-curator\" function right after a curator registers.\n * POST /wp-json/rew/v1/curator-welcome  with header X-RE-Secret (same secret as curator tracking).\n */\nadd_action( 'rest_api_init', function () {\n\tregister_rest_route( 'rew/v1', '/curator-welcome', array(\n\t\t'methods'             => 'POST',\n\t\t'permission_callback' => '__return_true',\n\t\t'callback'            => 'rew_curator_welcome_send',\n\t) );\n} );\n\nfunction rew_curator_welcome_send( WP_REST_Request $req ) {\n\t$secret = defined( 'RE_TRACK_SECRET' ) ? RE_TRACK_SECRET : '';\n\tif ( ! $secret || ! hash_equals( $secret, (string) $req->get_header( 'x_re_secret' ) ) ) {\n\t\treturn new WP_REST_Response( array( 'error' => 'forbidden' ), 403 );\n\t}\n\t$p     = $req->get_json_params();\n\t$name  = sanitize_text_field( $p['name'] ?? '' );\n\t$email = sanitize_email( $p['email'] ?? '' );\n\t$code  = sanitize_text_field( $p['code'] ?? '' );\n\t$store = esc_url_raw( $p['store_url'] ?? '' );\n\t$login = esc_url_raw( $p['login_url'] ?? 'https://sellers.rareearthwellness.com' );\n\tif ( ! is_email( $email ) || ! $code ) {\n\t\treturn new WP_REST_Response( array( 'error' => 'bad request' ), 400 );\n\t}\n\t$first = esc_html( strtok( $name, ' ' ) );\n\n\t$rows = '';\n\tforeach ( (array) ( $p['brochures'] ?? array() ) as $prod ) {\n\t\t$links = array();\n\t\tforeach ( (array) ( $prod['links'] ?? array() ) as $l ) {\n\t\t\t$links[] = '<a href=\"' . esc_url( $l['url'] ?? '' ) . '\" style=\"color:#166534\">' . esc_html( $l['title'] ?? 'Brochure' ) . '</a>';\n\t\t}\n\t\tif ( $links ) {\n\t\t\t$rows .= '<tr><td style=\"padding:6px 0;font-weight:bold;vertical-align:top;width:40%\">' . esc_html( $prod['product'] ?? '' ) . '</td><td style=\"padding:6px 0\">' . implode( ' \u00b7 ', $links ) . '</td></tr>';\n\t\t}\n\t}\n\n\t$hub   = 'https://rareearthwellness.com/rareearth-wellness-curator-academy/';\n\t$body  = '<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:auto;color:#1f2937;font-size:15px;line-height:1.55\">';\n\t$body .= '<div style=\"background:#14532d;color:#fff;padding:20px 24px;border-radius:10px 10px 0 0\"><div style=\"font-size:20px;font-weight:bold\">Welcome to Rareearth, ' . $first . '!</div><div style=\"opacity:.85\">Let Nature Nurture \u00b7 Eat right \u00b7 Breathe right \u00b7 Find your direction</div></div>';\n\t$body .= '<div style=\"border:1px solid #e5e7eb;border-top:0;padding:22px 24px;border-radius:0 0 10px 10px\">';\n\t$body .= '<p>Your curator account is ready. Here is everything you need:</p>';\n\t$body .= '<table style=\"width:100%;border-collapse:collapse;margin:8px 0 16px\">';\n\t$body .= '<tr><td style=\"padding:6px 0;width:40%\">Your curator code</td><td style=\"padding:6px 0;font-weight:bold;font-size:17px\">' . esc_html( $code ) . '</td></tr>';\n\t$body .= '<tr><td style=\"padding:6px 0\">Your store link</td><td style=\"padding:6px 0\"><a href=\"' . esc_url( $store ) . '\" style=\"color:#166534;font-weight:bold\">' . esc_html( $store ) . '</a></td></tr>';\n\t$body .= '<tr><td style=\"padding:6px 0\">Your dashboard</td><td style=\"padding:6px 0\"><a href=\"' . esc_url( $login ) . '\" style=\"color:#166534\">' . esc_html( $login ) . '</a> (log in with this email and the password you chose)</td></tr>';\n\t$body .= '</table>';\n\t$body .= '<h3 style=\"color:#14532d;margin:18px 0 6px\">How you earn</h3><ul style=\"padding-left:18px;margin:0\">';\n\t$body .= '<li>You earn <b>\u20b980 on every pouch</b> bought through your store link or brochure links.</li>';\n\t$body .= '<li>Every link you share already carries your code, so the sale is credited to you automatically.</li>';\n\t$body .= '<li>You can see your visits, orders and earnings any time in your dashboard. Commission is paid to your UPI ID.</li>';\n\t$body .= '<li>All products are made to order in a hygienic kitchen setup; delivery takes 4 to 5 business days.</li></ul>';\n\tif ( $rows ) {\n\t\t$body .= '<h3 style=\"color:#14532d;margin:18px 0 6px\">Ready-to-share brochures (with your code)</h3><table style=\"width:100%;border-collapse:collapse\">' . $rows . '</table>';\n\t\t$body .= '<p style=\"font-size:13px;color:#6b7280\">You will also find these, with Copy and WhatsApp buttons, under <b>Marketing</b> in your dashboard.</p>';\n\t}\n\t$body .= '<h3 style=\"color:#14532d;margin:18px 0 6px\">Your first 3 steps</h3><ol style=\"padding-left:18px;margin:0\">';\n\t$body .= '<li>Log in to your dashboard and open <b>Marketing</b>.</li>';\n\t$body .= '<li>Watch the short videos in the <a href=\"' . esc_url( $hub ) . '\" style=\"color:#166534\">Curator Academy</a>.</li>';\n\t$body .= '<li>Share one brochure with three families you know on WhatsApp today.</li></ol>';\n\t$body .= '<p style=\"margin-top:18px\">Please share honestly: these are traditional kitchen recipes, not medicines. Do not promise cures. Your Curator Program Agreement has the full guidelines.</p>';\n\t$body .= '<p>Questions? Reply to this email or write to concerns@rareearthwellness.com.</p>';\n\t$body .= '<p>Warmly,<br>Team Rareearth Wellness</p></div></div>';\n\n\t$headers = array( 'Content-Type: text/html; charset=UTF-8', 'Reply-To: Rareearth Wellness <concerns@rareearthwellness.com>' );\n\t$ok = wp_mail( $email, 'Welcome to Rareearth: your curator code ' . $code . ' and store link', $body, $headers );\n\t// Copy to admin\n\twp_mail( get_option( 'admin_email' ), 'New curator registered: ' . $name . ' (' . $code . ')',\n\t\t'Name: ' . $name . \"\\nEmail: \" . $email . \"\\nCode: \" . $code . \"\\nStore: \" . $store, array( 'Content-Type: text/plain; charset=UTF-8' ) );\n\n\treturn $ok ? new WP_REST_Response( array( 'sent' => true ), 200 ) : new WP_REST_Response( array( 'error' => 'wp_mail failed' ), 500 );\n}\n"
