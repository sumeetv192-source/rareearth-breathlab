"\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// 5. Lifetime customer ownership (10 Nov 2026)\n//    The first curator who brings a customer (matched by phone or email) earns on ALL her\n//    future orders, even after 30 days and even if she buys directly. Owner wins over a new\n//    link or a typed code. Runs just before the paid order is reported to the Seller Notebook.\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfunction re_track_phone10( $p ) {\n\t$d = preg_replace( '/\\D/', '', (string) $p );\n\treturn strlen( $d ) >= 10 ? substr( $d, -10 ) : '';\n}\n\nfunction re_track_find_owner( $order ) {\n\t$email = strtolower( trim( (string) $order->get_billing_email() ) );\n\t$ph    = re_track_phone10( $order->get_billing_phone() );\n\t$found = array();\n\t$paid  = array( 'processing', 'completed' );\n\tif ( $email ) {\n\t\tforeach ( wc_get_orders( array( 'billing_email' => $email, 'status' => $paid, 'limit' => 50, 'orderby' => 'date', 'order' => 'ASC' ) ) as $o ) {\n\t\t\t$found[ $o->get_id() ] = $o;\n\t\t}\n\t}\n\tif ( $ph ) {\n\t\tforeach ( array( $ph, '+91' . $ph, '91' . $ph, '+91 ' . $ph, '0' . $ph ) as $variant ) {\n\t\t\tforeach ( wc_get_orders( array( 'billing_phone' => $variant, 'status' => $paid, 'limit' => 50, 'orderby' => 'date', 'order' => 'ASC' ) ) as $o ) {\n\t\t\t\t$found[ $o->get_id() ] = $o;\n\t\t\t}\n\t\t}\n\t}\n\tunset( $found[ $order->get_id() ] );\n\tuasort( $found, function ( $a, $b ) { return $a->get_date_created() <=> $b->get_date_created(); } );\n\tforeach ( $found as $o ) {\n\t\t$c = re_track_clean_code( $o->get_meta( '_re_curator' ) );\n\t\tif ( $c !== '' ) {\n\t\t\treturn $c; // earliest curator-credited order = owner\n\t\t}\n\t}\n\treturn '';\n}\n\nadd_action( 'woocommerce_order_status_changed', function ( $order_id, $from, $to, $order ) {\n\tif ( ! in_array( $to, array( 'processing', 'completed' ), true ) || $order->get_meta( '_re_owner_checked' ) ) {\n\t\treturn;\n\t}\n\t$owner = re_track_find_owner( $order );\n\t$order->update_meta_data( '_re_owner_checked', 1 );\n\tif ( $owner !== '' ) {\n\t\t$had = re_track_clean_code( $order->get_meta( '_re_curator' ) );\n\t\tif ( $had !== $owner ) {\n\t\t\t$order->update_meta_data( '_re_curator', $owner );\n\t\t\t$order->add_order_note( 'Curator tracking: repeat customer of ' . $owner . ' (lifetime ownership)' . ( $had ? '; link/code ' . $had . ' not used' : '' ) . '.' );\n\t\t}\n\t}\n\t$order->save_meta_data();\n}, 5, 4 );\n"