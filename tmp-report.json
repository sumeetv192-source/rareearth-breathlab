"/**\n * Rareearth Daily Report (WPCode PHP snippet, run everywhere)\n * - WooCommerce \u2192 \"Rareearth Report\": download the Excel report any time.\n * - Every morning (~07:13 IST) the report is emailed to REW_REPORT_TO.\n * Sheets: Summary, Open orders, All orders, Sales by product, Daily product sales (30 days),\n *         Sales by curator, Commission payable.\n * Source of truth: WooCommerce orders (+ curator code saved by the tracking snippet).\n */\nif ( ! defined( 'REW_REPORT_TO' ) ) { define( 'REW_REPORT_TO', 'sumit@rareearthwellness.com' ); }\nif ( ! defined( 'REW_COMMISSION' ) ) { define( 'REW_COMMISSION', 80 ); } // \u20b9 per pouch (kadha products)\n\n// \u2500\u2500 data \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfunction rew_rpt_status_group( $s ) {\n\tif ( $s === 'pending' ) return 'Pending payment';\n\tif ( in_array( $s, array( 'processing', 'on-hold' ), true ) ) return 'In progress';\n\tif ( $s === 'completed' ) return 'Completed';\n\treturn 'Cancelled / failed / refunded';\n}\nfunction rew_rpt_short( $name ) {\n\t$p = preg_split( '/\\s+[\u2013-]\\s+/u', $name );\n\treturn trim( $p[0] );\n}\nfunction rew_rpt_curators() {\n\t$map = get_option( 'rew_curator_names', array() );\n\treturn is_array( $map ) ? $map : array();\n}\nfunction rew_rpt_collect() {\n\t$tz    = wp_timezone();\n\t$now   = new DateTime( 'now', $tz );\n\t$today = ( clone $now )->setTime( 0, 0 );\n\t$week  = ( clone $today )->modify( 'monday this week' );\n\t$month = ( clone $today )->modify( 'first day of this month' );\n\t$orders = wc_get_orders( array( 'limit' => -1, 'type' => 'shop_order', 'orderby' => 'date', 'order' => 'DESC', 'status' => array_keys( wc_get_order_statuses() ) ) );\n\t$names  = rew_rpt_curators();\n\t$rows   = array();\n\tforeach ( $orders as $o ) {\n\t\t$d = $o->get_date_created();\n\t\tif ( ! $d ) continue;\n\t\t$dt = ( new DateTime( '@' . $d->getTimestamp() ) )->setTimezone( $tz );\n\t\t$items = array(); $units = 0; $comm_units = 0;\n\t\tforeach ( $o->get_items() as $it ) {\n\t\t\t$q = (int) $it->get_quantity();\n\t\t\t$items[] = array( 'name' => rew_rpt_short( $it->get_name() ), 'qty' => $q, 'value' => (float) $it->get_total() + (float) $it->get_total_tax() );\n\t\t\t$units += $q;\n\t\t\t$pid = (int) $it->get_product_id();\n\t\t\tif ( has_term( 'teen-wellness-kadha', 'product_cat', $pid ) || preg_match( '/kadha|blend/i', $it->get_name() ) ) $comm_units += $q;\n\t\t}\n\t\t$code = (string) $o->get_meta( '_re_curator' );\n\t\t$grp  = rew_rpt_status_group( $o->get_status() );\n\t\t$paid = in_array( $grp, array( 'In progress', 'Completed' ), true );\n\t\t$rows[] = array(\n\t\t\t'id' => $o->get_id(), 'dt' => $dt, 'status' => $grp, 'raw' => wc_get_order_status_name( $o->get_status() ),\n\t\t\t'customer' => trim( $o->get_billing_first_name() . ' ' . $o->get_billing_last_name() ),\n\t\t\t'city' => $o->get_billing_city(), 'phone' => $o->get_billing_phone(),\n\t\t\t'items' => $items, 'units' => $units, 'total' => (float) $o->get_total(), 'paid' => $paid,\n\t\t\t'code' => $code, 'curator' => $code ? ( $names[ $code ]['name'] ?? '' ) : '',\n\t\t\t'commission' => ( $paid && $code ) ? $comm_units * REW_COMMISSION : 0,\n\t\t\t'age' => (int) floor( ( $now->getTimestamp() - $dt->getTimestamp() ) / 86400 ),\n\t\t);\n\t}\n\treturn array( 'rows' => $rows, 'now' => $now, 'today' => $today, 'week' => $week, 'month' => $month );\n}\n\n// \u2500\u2500 tiny XLSX writer (no library needed) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfunction rew_x( $s ) { return htmlspecialchars( (string) $s, ENT_XML1 | ENT_QUOTES, 'UTF-8' ); }\nfunction rew_col( $i ) { $s = ''; $i++; while ( $i > 0 ) { $m = ( $i - 1 ) % 26; $s = chr( 65 + $m ) . $s; $i = intdiv( $i - $m, 26 ); } return $s; }\n/** $sheet = ['name'=>..,'widths'=>[..],'rows'=>[[cell..]..]]; cell = scalar | ['v'=>..,'s'=>styleId] ; styles: 1 header, 2 title, 3 money, 4 bold, 5 bold money, 6 date */\nfunction rew_xlsx( $sheets, $path ) {\n\t$z = new ZipArchive();\n\tif ( true !== $z->open( $path, ZipArchive::CREATE | ZipArchive::OVERWRITE ) ) return false;\n\t$ct = '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?><Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\"><Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/><Default Extension=\"xml\" ContentType=\"application/xml\"/><Override PartName=\"/xl/workbook.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml\"/><Override PartName=\"/xl/styles.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml\"/>';\n\t$wb = '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?><workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\"><sheets>';\n\t$rels = '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">';\n\tforeach ( $sheets as $i => $sh ) {\n\t\t$n = $i + 1;\n\t\t$ct .= '<Override PartName=\"/xl/worksheets/sheet' . $n . '.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml\"/>';\n\t\t$wb .= '<sheet name=\"' . rew_x( substr( $sh['name'], 0, 31 ) ) . '\" sheetId=\"' . $n . '\" r:id=\"rId' . $n . '\"/>';\n\t\t$rels .= '<Relationship Id=\"rId' . $n . '\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet\" Target=\"worksheets/sheet' . $n . '.xml\"/>';\n\t\t$x = '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?><worksheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\">';\n\t\tif ( ! empty( $sh['freeze'] ) ) $x .= '<sheetViews><sheetView workbookViewId=\"0\"><pane ySplit=\"' . (int) $sh['freeze'] . '\" topLeftCell=\"A' . ( (int) $sh['freeze'] + 1 ) . '\" activePane=\"bottomLeft\" state=\"frozen\"/></sheetView></sheetViews>';\n\t\tif ( ! empty( $sh['widths'] ) ) { $x .= '<cols>'; foreach ( $sh['widths'] as $c => $w ) $x .= '<col min=\"' . ( $c + 1 ) . '\" max=\"' . ( $c + 1 ) . '\" width=\"' . $w . '\" customWidth=\"1\"/>'; $x .= '</cols>'; }\n\t\t$x .= '<sheetData>';\n\t\tforeach ( $sh['rows'] as $r => $row ) {\n\t\t\t$x .= '<row r=\"' . ( $r + 1 ) . '\">';\n\t\t\tforeach ( $row as $c => $cell ) {\n\t\t\t\t$v = is_array( $cell ) ? ( $cell['v'] ?? '' ) : $cell;\n\t\t\t\t$s = is_array( $cell ) ? (int) ( $cell['s'] ?? 0 ) : 0;\n\t\t\t\tif ( $v === '' || $v === null ) { if ( $s ) $x .= '<c r=\"' . rew_col( $c ) . ( $r + 1 ) . '\" s=\"' . $s . '\"/>'; continue; }\n\t\t\t\t$ref = rew_col( $c ) . ( $r + 1 );\n\t\t\t\tif ( is_int( $v ) || is_float( $v ) ) $x .= '<c r=\"' . $ref . '\" s=\"' . $s . '\"><v>' . $v . '</v></c>';\n\t\t\t\telse $x .= '<c r=\"' . $ref . '\" s=\"' . $s . '\" t=\"inlineStr\"><is><t xml:space=\"preserve\">' . rew_x( $v ) . '</t></is></c>';\n\t\t\t}\n\t\t\t$x .= '</row>';\n\t\t}\n\t\t$x .= '</sheetData></worksheet>';\n\t\t$z->addFromString( 'xl/worksheets/sheet' . $n . '.xml', $x );\n\t}\n\t$ct .= '</Types>';\n\t$wb .= '</sheets></workbook>';\n\t$rels .= '<Relationship Id=\"rIdS\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles\" Target=\"styles.xml\"/></Relationships>';\n\t$styles = '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?><styleSheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\">'\n\t\t. '<numFmts count=\"2\"><numFmt numFmtId=\"164\" formatCode=\"&quot;\u20b9&quot;#,##0\"/><numFmt numFmtId=\"165\" formatCode=\"dd-mmm-yyyy hh:mm\"/></numFmts>'\n\t\t. '<fonts count=\"4\"><font><sz val=\"10\"/><name val=\"Calibri\"/></font><font><b/><sz val=\"10\"/><color rgb=\"FFFFFFFF\"/><name val=\"Calibri\"/></font><font><b/><sz val=\"14\"/><color rgb=\"FF244B35\"/><name val=\"Calibri\"/></font><font><b/><sz val=\"10\"/><name val=\"Calibri\"/></font></fonts>'\n\t\t. '<fills count=\"3\"><fill><patternFill patternType=\"none\"/></fill><fill><patternFill patternType=\"gray125\"/></fill><fill><patternFill patternType=\"solid\"><fgColor rgb=\"FF244B35\"/><bgColor indexed=\"64\"/></patternFill></fill></fills>'\n\t\t. '<borders count=\"1\"><border><left/><right/><top/><bottom/><diagonal/></border></borders>'\n\t\t. '<cellStyleXfs count=\"1\"><xf numFmtId=\"0\" fontId=\"0\" fillId=\"0\" borderId=\"0\"/></cellStyleXfs>'\n\t\t. '<cellXfs count=\"7\"><xf numFmtId=\"0\" fontId=\"0\" fillId=\"0\" borderId=\"0\" xfId=\"0\"/>'\n\t\t. '<xf numFmtId=\"0\" fontId=\"1\" fillId=\"2\" borderId=\"0\" xfId=\"0\" applyFont=\"1\" applyFill=\"1\"/>'\n\t\t. '<xf numFmtId=\"0\" fontId=\"2\" fillId=\"0\" borderId=\"0\" xfId=\"0\" applyFont=\"1\"/>'\n\t\t. '<xf numFmtId=\"164\" fontId=\"0\" fillId=\"0\" borderId=\"0\" xfId=\"0\" applyNumberFormat=\"1\"/>'\n\t\t. '<xf numFmtId=\"0\" fontId=\"3\" fillId=\"0\" borderId=\"0\" xfId=\"0\" applyFont=\"1\"/>'\n\t\t. '<xf numFmtId=\"164\" fontId=\"3\" fillId=\"0\" borderId=\"0\" xfId=\"0\" applyFont=\"1\" applyNumberFormat=\"1\"/>'\n\t\t. '<xf numFmtId=\"165\" fontId=\"0\" fillId=\"0\" borderId=\"0\" xfId=\"0\" applyNumberFormat=\"1\"/></cellXfs>'\n\t\t. '<cellStyles count=\"1\"><cellStyle name=\"Normal\" xfId=\"0\" builtinId=\"0\"/></cellStyles></styleSheet>';\n\t$z->addFromString( '[Content_Types].xml', $ct );\n\t$z->addFromString( '_rels/.rels', '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"xl/workbook.xml\"/></Relationships>' );\n\t$z->addFromString( 'xl/workbook.xml', $wb );\n\t$z->addFromString( 'xl/_rels/workbook.xml.rels', $rels );\n\t$z->addFromString( 'xl/styles.xml', $styles );\n\treturn $z->close();\n}\n\n// \u2500\u2500 build the report \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfunction rew_rpt_build( $path ) {\n\t$D = rew_rpt_collect();\n\t$rows = $D['rows'];\n\t$H = function ( $cols ) { return array_map( function ( $c ) { return array( 'v' => $c, 's' => 1 ); }, $cols ); };\n\t$M = function ( $v ) { return array( 'v' => (float) $v, 's' => 3 ); };\n\t$in = function ( $r, $from ) { return $r['dt'] >= $from; };\n\t$periods = array( 'Today' => $D['today'], 'This week' => $D['week'], 'This month' => $D['month'], 'All time' => new DateTime( '2000-01-01', wp_timezone() ) );\n\n\t// Summary\n\t$S = array( array( array( 'v' => 'Rareearth daily report', 's' => 2 ) ), array( 'Generated ' . $D['now']->format( 'd M Y, H:i' ) . ' IST' ), array() );\n\t$S[] = $H( array( 'Paid sales', 'Today', 'This week', 'This month', 'All time' ) );\n\t$metrics = array( 'Orders' => 'n', 'Units (pouches/items)' => 'u', 'Sales value (\u20b9)' => 'v', 'Through curators (\u20b9)' => 'cv', 'Direct (\u20b9)' => 'dv', 'Curator commission earned (\u20b9)' => 'cm' );\n\tforeach ( $metrics as $label => $k ) {\n\t\t$line = array( array( 'v' => $label, 's' => 4 ) );\n\t\tforeach ( $periods as $from ) {\n\t\t\t$sum = 0;\n\t\t\tforeach ( $rows as $r ) {\n\t\t\t\tif ( ! $r['paid'] || ! $in( $r, $from ) ) continue;\n\t\t\t\t$sum += ( $k === 'n' ? 1 : ( $k === 'u' ? $r['units'] : ( $k === 'v' ? $r['total'] : ( $k === 'cv' ? ( $r['code'] ? $r['total'] : 0 ) : ( $k === 'dv' ? ( $r['code'] ? 0 : $r['total'] ) : $r['commission'] ) ) ) ) );\n\t\t\t}\n\t\t\t$line[] = in_array( $k, array( 'n', 'u' ), true ) ? $sum : $M( $sum );\n\t\t}\n\t\t$S[] = $line;\n\t}\n\t$S[] = array();\n\t$S[] = $H( array( 'Order status (all orders)', 'Today', 'This week', 'This month', 'All time' ) );\n\tforeach ( array( 'Pending payment', 'In progress', 'Completed', 'Cancelled / failed / refunded' ) as $g ) {\n\t\t$line = array( array( 'v' => $g, 's' => 4 ) );\n\t\tforeach ( $periods as $from ) { $c = 0; foreach ( $rows as $r ) if ( $r['status'] === $g && $in( $r, $from ) ) $c++; $line[] = $c; }\n\t\t$S[] = $line;\n\t}\n\t$open = array_filter( $rows, function ( $r ) { return in_array( $r['status'], array( 'Pending payment', 'In progress' ), true ); } );\n\t$S[] = array();\n\t$S[] = array( array( 'v' => 'Open orders right now: ' . count( $open ) . ' (see the \"Open orders\" sheet). Oldest: ' . ( $open ? max( array_column( $open, 'age' ) ) . ' days' : '-' ), 's' => 4 ) );\n\n\t// Open orders\n\t$O = array( $H( array( 'Order #', 'Placed', 'Age (days)', 'Status', 'Customer', 'City', 'Phone', 'Products', 'Value', 'Curator code' ) ) );\n\tforeach ( $open as $r ) {\n\t\t$O[] = array( $r['id'], $r['dt']->format( 'd-M-Y H:i' ), $r['age'], $r['status'], $r['customer'], $r['city'], $r['phone'], implode( ', ', array_map( function ( $i ) { return $i['name'] . ' x' . $i['qty']; }, $r['items'] ) ), $M( $r['total'] ), $r['code'] ?: 'Direct' );\n\t}\n\n\t// All orders\n\t$A = array( $H( array( 'Order #', 'Date', 'Week', 'Month', 'Status', 'WooCommerce status', 'Customer', 'City', 'Products', 'Units', 'Value', 'Curator code', 'Curator name', 'Commission' ) ) );\n\tforeach ( $rows as $r ) {\n\t\t$A[] = array( $r['id'], $r['dt']->format( 'd-M-Y H:i' ), $r['dt']->format( 'o-\\WW' ), $r['dt']->format( 'Y-m' ), $r['status'], $r['raw'], $r['customer'], $r['city'], implode( ', ', array_map( function ( $i ) { return $i['name'] . ' x' . $i['qty']; }, $r['items'] ) ), $r['units'], $M( $r['total'] ), $r['code'] ?: 'Direct', $r['curator'], $M( $r['commission'] ) );\n\t}\n\n\t// Sales by product (paid orders)\n\t$P = array( $H( array( 'Product', 'Units today', 'Units this week', 'Units this month', 'Units all time', '\u20b9 today', '\u20b9 this week', '\u20b9 this month', '\u20b9 all time' ) ) );\n\t$prod = array();\n\tforeach ( $rows as $r ) { if ( ! $r['paid'] ) continue; foreach ( $r['items'] as $i ) { foreach ( array_values( $periods ) as $k => $from ) { if ( ! $in( $r, $from ) ) continue; $prod[ $i['name'] ]['u'][ $k ] = ( $prod[ $i['name'] ]['u'][ $k ] ?? 0 ) + $i['qty']; $prod[ $i['name'] ]['v'][ $k ] = ( $prod[ $i['name'] ]['v'][ $k ] ?? 0 ) + $i['value']; } } }\n\tksort( $prod );\n\tforeach ( $prod as $name => $p ) { $line = array( $name ); for ( $k = 0; $k < 4; $k++ ) $line[] = $p['u'][ $k ] ?? 0; for ( $k = 0; $k < 4; $k++ ) $line[] = $M( $p['v'][ $k ] ?? 0 ); $P[] = $line; }\n\n\t// Daily product units, last 30 days\n\t$names = array_keys( $prod );\n\t$DP = array( $H( array_merge( array( 'Date' ), $names, array( 'Total units', 'Sales \u20b9' ) ) ) );\n\tfor ( $d = 29; $d >= 0; $d-- ) {\n\t\t$day = ( clone $D['today'] )->modify( \"-$d days\" ); $next = ( clone $day )->modify( '+1 day' );\n\t\t$line = array( $day->format( 'D d-M-Y' ) ); $tu = 0; $tv = 0; $cnt = array_fill_keys( $names, 0 );\n\t\tforeach ( $rows as $r ) { if ( ! $r['paid'] || $r['dt'] < $day || $r['dt'] >= $next ) continue; $tv += $r['total']; foreach ( $r['items'] as $i ) { if ( isset( $cnt[ $i['name'] ] ) ) { $cnt[ $i['name'] ] += $i['qty']; $tu += $i['qty']; } } }\n\t\tforeach ( $names as $n ) $line[] = $cnt[ $n ];\n\t\t$line[] = $tu; $line[] = $M( $tv ); $DP[] = $line;\n\t}\n\n\t// Sales by curator\n\t$C = array( $H( array( 'Curator code', 'Curator name', 'Orders today', 'Orders this week', 'Orders this month', 'Orders all time', 'Units all time', 'Sales \u20b9 this month', 'Sales \u20b9 all time', 'Commission \u20b9 all time' ) ) );\n\t$cur = array();\n\tforeach ( $rows as $r ) { if ( ! $r['paid'] ) continue; $k = $r['code'] ?: 'Direct'; foreach ( array_values( $periods ) as $i => $from ) if ( $in( $r, $from ) ) $cur[ $k ]['o'][ $i ] = ( $cur[ $k ]['o'][ $i ] ?? 0 ) + 1; $cur[ $k ]['u'] = ( $cur[ $k ]['u'] ?? 0 ) + $r['units']; if ( $in( $r, $D['month'] ) ) $cur[ $k ]['vm'] = ( $cur[ $k ]['vm'] ?? 0 ) + $r['total']; $cur[ $k ]['v'] = ( $cur[ $k ]['v'] ?? 0 ) + $r['total']; $cur[ $k ]['c'] = ( $cur[ $k ]['c'] ?? 0 ) + $r['commission']; $cur[ $k ]['n'] = $r['curator']; }\n\tuasort( $cur, function ( $a, $b ) { return ( $b['v'] ?? 0 ) <=> ( $a['v'] ?? 0 ); } );\n\tforeach ( $cur as $code => $c ) $C[] = array( $code, $code === 'Direct' ? '(no curator)' : ( $c['n'] ?? '' ), $c['o'][0] ?? 0, $c['o'][1] ?? 0, $c['o'][2] ?? 0, $c['o'][3] ?? 0, $c['u'] ?? 0, $M( $c['vm'] ?? 0 ), $M( $c['v'] ?? 0 ), $M( $c['c'] ?? 0 ) );\n\n\t// Commission payable (earned on paid orders; payouts are recorded in the Seller Notebook)\n\t$CP = array( array( array( 'v' => 'Commission earned per curator (paid orders). Mark payouts in Seller Notebook \u2192 Admin \u2192 Pay; the curator sees them in her dashboard.', 's' => 4 ) ), array(), $H( array( 'Curator code', 'Curator name', 'UPI ID', 'Orders', 'Commission earned \u20b9', 'Of which in progress \u20b9', 'Of which completed \u20b9' ) ) );\n\t$names_map = rew_rpt_curators(); $cp = array();\n\tforeach ( $rows as $r ) { if ( ! $r['code'] || ! $r['paid'] ) continue; $k = $r['code']; $cp[ $k ]['o'] = ( $cp[ $k ]['o'] ?? 0 ) + 1; $cp[ $k ]['e'] = ( $cp[ $k ]['e'] ?? 0 ) + $r['commission']; $cp[ $k ][ $r['status'] === 'Completed' ? 'd' : 'p' ] = ( $cp[ $k ][ $r['status'] === 'Completed' ? 'd' : 'p' ] ?? 0 ) + $r['commission']; }\n\tforeach ( $cp as $code => $c ) $CP[] = array( $code, $names_map[ $code ]['name'] ?? '', $names_map[ $code ]['upi'] ?? '', $c['o'], $M( $c['e'] ), $M( $